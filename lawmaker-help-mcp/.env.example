# Lawmaker Help MCP Server - Environment Configuration

# Required: OpenAI API key for generating embeddings
OPENAI_API_KEY=sk-your-api-key-here

# Optional: Custom OpenAI-compatible API base URL
# Leave blank to use the default OpenAI API
# OPENAI_BASE_URL=https://api.openai.com/v1

# Optional: Embeddings model (default: text-embedding-3-small)
# EMBEDDINGS_MODEL=text-embedding-3-small

# Optional: Path to the vector store JSON file
# (default: ./data/vector-store.json)
# VECTOR_STORE_PATH=./data/vector-store.json

# Optional: MCP Transport mode (default: stdio)
# Possible values: stdio, http
# MCP_TRANSPORT=stdio

# Optional: HTTP server port (used when MCP_TRANSPORT=http)
# (default: 3000)
# PORT=3000

# Optional: Server key for HTTP authentication (used when MCP_TRANSPORT=http)
# MCP_SERVER_KEY=your-secret-key
